{
    "name": "cloudflare-payloadcms-starterkit",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
        "typegen": "payload generate:types && payload generate:importmap",
        "generate:schema": "payload generate:db-schema",
        "migrate:create": "drizzle-kit generate",
        "migrate:local": "wrangler d1 migrations apply db-name --local",
        "migrate:deploy": "wrangler d1 migrations apply db-name --remote",
        "email:dev": "email dev --dir src/emails --port 3001"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@opennextjs/cloudflare": "^1.19.9",
        "@payloadcms/db-d1-sqlite": "^3.85.0",
        "@payloadcms/next": "^3.85.0",
        "@payloadcms/richtext-lexical": "^3.85.0",
        "@payloadcms/storage-r2": "^3.85.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "drizzle-orm": "^0.45.2",
        "embla-carousel-react": "^8.6.0",
        "graphql": "^16.14.1",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.17.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "payload": "^3.85.0",
        "radix-ui": "^1.4.3",
        "react": "^19.1.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.1.7",
        "react-email": "^6.5.0",
        "react-resizable-panels": "^4.11.2",
        "recharts": "3.8.0",
        "shadcn": "^4.10.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@react-email/ui": "6.5.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19.1.7",
        "@types/react-dom": "^19.1.7",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "tailwindcss": "^4",
        "tsx": "^4.22.4",
        "typescript": "^5.7.4",
        "wrangler": "^4.97.0"
    },
    "pnpm": {
        "overrides": {
            "esbuild": "^0.28.0"
        }
    }
}
