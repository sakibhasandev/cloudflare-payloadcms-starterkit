{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    // shadcn/ui ships with this starter kit — its components and the use-mobile hook
    // sit unused until you build with them, and the drizzle-kit stub is loaded at
    // build time via the turbopack resolveAlias in next.config.ts (not a static
    // import). Treat all of these as always-live so they don't dominate the
    // dead-code report. Remove an entry once you actually wire the component up.
    "dynamicallyLoaded": [
        "src/components/ui/**/*.tsx",
        "src/hooks/use-mobile.ts",
        "stubs/**/*.mjs"
    ],
    // Generated type-declaration files — exclude entirely. They drown out the
    // duplication and dead-code signal and are regenerated by `cf-typegen` /
    // `payload generate:types`, so there's nothing to act on inside them.
    "ignorePatterns": [
        "cloudflare-env.d.ts",
        "payload-types.d.ts",
        "next-env.d.ts"
    ],
    // eslint-config-next is consumed via compat.extends("next/core-web-vitals",
    // "next/typescript") in eslint.config.mjs — a FlatCompat string, not a static
    // import — so fallow can't see the usage and flags it as unused. It's live.
    "ignoreDependencies": [
        "eslint-config-next",
        "@react-email/ui"
    ]
}